{
	"name": "openai-oauth",
	"version": "2.1.1",
	"description": "Free OpenAI API access with your ChatGPT account.",
	"keywords": [
		"openai",
		"oauth",
		"chatgpt",
		"codex",
		"cli",
		"openai-compatible"
	],
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"openai-oauth": "dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"scripts": {
		"build": "tsup src/index.ts src/cli.ts --format esm --dts --outDir dist --clean --loader .html=text",
		"dev": "bun ./src/cli.ts",
		"prepublishOnly": "bun run build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:live": "LIVE_CODEX_E2E=1 vitest run test/live.e2e.test.ts"
	},
	"dependencies": {
		"@openai-oauth/ai-sdk": "workspace:*",
		"@openai-oauth/core": "workspace:*",
		"@openai-oauth/local": "workspace:*",
		"ai": "7.0.165",
		"yargs": "18.2.0"
	},
	"devDependencies": {
		"@ai-sdk/openai": "4.0.111",
		"@types/node": "26.6.6",
		"@types/yargs": "^17.0.35",
		"typescript": "6.0.3",
		"vitest": "5.1.0",
		"zod": "^4.6.7"
	},
	"author": "EvanZhouDev",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RogerNavelsaker/openai-oauth.git",
		"directory": "packages/openai-oauth"
	},
	"bugs": {
		"url": "https://github.com/RogerNavelsaker/openai-oauth/issues"
	},
	"homepage": "https://github.com/RogerNavelsaker/openai-oauth#readme"
}
